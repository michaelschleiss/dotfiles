#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
dry="0"
verbose="0"
requested=()

cd "$script_dir"
# Core modules run first, in this order: base installs package managers,
# zsh-profile puts ~/.local/bin etc. on PATH for everything installed later.
core=(base zsh-profile)
scripts=()
while IFS= read -r script; do
    scripts+=("$script")
done < <(
    for name in "${core[@]}"; do
        [[ -x "runs/$name" ]] && printf '%s\n' "runs/$name"
    done
    find runs -maxdepth 1 -mindepth 1 -type f -perm -u=x \
        $(printf -- '! -name %s ' "${core[@]}") | sort
)

while [[ $# > 0 ]]; do
    case "$1" in
        --dry)
            dry="1"
            ;;
        --verbose|-v)
            verbose="1"
            ;;
        --*)
            echo "Unknown option: $1" >&2
            exit 2
            ;;
        *)
            requested+=("$1")
            ;;
    esac
    shift
done

export RUN_VERBOSE="$verbose"

if (( ${#requested[@]} > 0 )); then
    selected=()
    for module in "${requested[@]}"; do
        match=""
        for script in "${scripts[@]}"; do
            if [[ "$(basename "$script")" == "$module" ]]; then
                match="$script"
                break
            fi
        done

        if [[ -z "$match" ]]; then
            echo "Unknown run module: $module" >&2
            exit 2
        fi
        selected+=("$match")
    done
    scripts=("${selected[@]}")
fi

log() {
    if [[ $dry == "1" ]]; then
        echo "[DRY_RUN]: $@"
    else
        echo "$@"
    fi
}

execute() {
    log "execute: $@"
    if [[ $dry == "1" ]]; then
        return
    fi

    "$@"
}

log "run: modules=${requested[*]:-all}"

# A failing module doesn't stop the run, except a core one: everything else
# depends on it.
failed=()
for script in "${scripts[@]}"; do
    log "running script: $script"
    if ! execute ./$script; then
        name="$(basename "$script")"
        echo "run: module failed: $name" >&2
        failed+=("$name")
        if [[ " ${core[*]} " == *" $name "* ]]; then
            echo "run: aborting, core module failed" >&2
            exit 1
        fi
    fi
done

if (( ${#failed[@]} > 0 )); then
    echo "run: failed modules: ${failed[*]}" >&2
    exit 1
fi
