#!/usr/bin/env bash
set -euo pipefail
LOG_PREFIX="[vm]"
source "$(dirname "$0")/_lib"

# Headless agent VM profile (GCE). Lean on purpose: no desktop apps, no codex,
# no permission-skipping aliases. Skips itself everywhere else so `./run`
# without arguments stays safe on laptops; force with RUN_VM=1.

is_gce() {
  [[ -r /sys/class/dmi/id/product_name ]] && grep -q "Google Compute Engine" /sys/class/dmi/id/product_name
}

if [[ "${RUN_VM:-0}" != "1" ]] && ! is_gce; then
  log "Skipping: not a GCE VM (set RUN_VM=1 to force)"
  exit 0
fi

if [[ "$os_name" != "Linux" ]]; then
  log "Skipping: Linux only"
  exit 0
fi

export PATH="${HOME}/.local/bin:${PATH}"

log "Installing packages"
sudo apt-get update -qq
sudo apt-get install -qq -y \
  git curl wget ca-certificates build-essential pkg-config unzip htop rsync jq \
  tmux ncurses-term ripgrep fd-find fzf bat direnv python3 python3-pip python3-venv \
  zsh zsh-syntax-highlighting zsh-autosuggestions

mkdir -p "$HOME/.local/bin"
have bat  || { have batcat && ln -sf "$(command -v batcat)" "$HOME/.local/bin/bat"; }
have fd   || { have fdfind && ln -sf "$(command -v fdfind)" "$HOME/.local/bin/fd"; }

if ! have node || [[ "$(node -v | cut -c2-3)" -lt 22 ]]; then
  log "Installing Node.js 22 LTS via NodeSource"
  curl -fsSL https://deb.nodesource.com/setup_22.x | sudo -E bash - >/dev/null
  sudo apt-get install -qq -y nodejs
fi

if ! have claude; then
  log "Installing Claude Code"
  curl -fsSL https://claude.ai/install.sh | bash >/dev/null
fi

if ! have herdr; then
  log "Installing herdr"
  sh -c "$(curl -fsSL https://herdr.dev/install.sh)" >/dev/null
fi

# runs/git does the same but also needs interactive gh/glab logins.
git config --global user.name "Michael Schleiss"
git config --global user.email "michael.schleiss@skd.systems"
git config --global init.defaultBranch main
git config --global pull.rebase false

# The claude hooks deployed by dev-env expect rtk (same pin as runs/ai).
install_pinned_github_release rtk rtk-ai/rtk 0.42.0 rtk-x86_64-unknown-linux-musl.tar.gz

if [[ ! -d "$HOME/.tmux/plugins/tpm" ]]; then
  log "Installing tmux plugin manager"
  mkdir -p "$HOME/.tmux/plugins"
  git clone -q https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
fi
if [[ -f "$HOME/.config/tmux/tmux.conf" ]]; then
  log "Installing tmux plugins"
  TMUX_PLUGIN_MANAGER_PATH="$HOME/.tmux/plugins" "$HOME/.tmux/plugins/tpm/bin/install_plugins" >/dev/null || true
fi

# Same block name as runs/ai so the two never fight over it.
add_block_to_file "$HOME/.zprofile" "ai-env" 'export CLAUDE_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/claude"
export CODEX_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/codex"
export SERENA_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/serena"'

# Login shell cannot be changed for OS Login users; hand interactive bash sessions to zsh.
add_block_to_file "$HOME/.bashrc" "vm-zsh" 'if [[ $- == *i* ]] && [[ -z "${ZSH_VERSION:-}" ]] && command -v zsh >/dev/null 2>&1; then
  export SHELL="$(command -v zsh)"
  exec zsh -l
fi'

# Ghostty's terminfo is rarely present on remote hosts.
add_block_to_file "$HOME/.zshrc" "vm-term" '[[ "$TERM" == "xterm-ghostty" ]] && export TERM=xterm-256color'
add_block_to_file "$HOME/.zshrc" "vm-aliases" 'alias cc="claude"
alias t="tmux new -As main"'

log "Done"
