#!/usr/bin/env bash
set -euo pipefail
LOG_PREFIX="[zsh]"
source "$(dirname "$0")/_lib"

add_zsh_block() {
  local content
  content="$(cat)"
  add_block_to_file "$HOME/.zshrc" "$1" "$content"
}

# macOS includes zsh; Linux needs the shell and packaged plugins.
if [[ "$os_name" == "Linux" ]]; then
  log "Installing zsh and plugins"
  sudo apt-get update -qq
  sudo apt-get install -qq -y zsh zsh-syntax-highlighting zsh-autosuggestions
fi

# Commands referenced by the generated interactive configuration.
ensure_cmd direnv direnv
ensure_cmd fzf fzf
ensure_cmd bat bat
if ! have bat && have batcat; then
  mkdir -p "$HOME/.local/bin"
  ln -sf "$(command -v batcat)" "$HOME/.local/bin/bat"
fi

# Set zsh as default shell.
if [[ "${SHELL##*/}" != "zsh" ]]; then
  log "Setting zsh as default shell"
  chsh -s "$(command -v zsh)"
else
  log "zsh already default shell"
fi

add_zsh_block "zsh-history" <<'EOF'
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=900000
setopt INC_APPEND_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY
setopt EXTENDED_HISTORY
setopt HIST_IGNORE_SPACE
EOF

# Generated completion functions (e.g. _codex from runs/ai) live in ~/.zfunc.
mkdir -p "$HOME/.zfunc"

# The only compinit in .zshrc. Every completion dir must be on fpath before it
# runs: compinit rebuilds ~/.zcompdump whenever fpath differs from the dump, so
# a second compinit with a different fpath rebuilds on every shell start.
#
# Cache: compinit -C trusts the dump blindly, and even plain compinit only
# compares the file count. So rebuild from scratch exactly when the inputs
# changed: fpath itself (recorded in .zcompdump.fpath) or any fpath dir newer
# than the dump (adding/removing/renaming a file bumps the dir's mtime). File
# contents need no check: the dump holds autoload stubs, bodies load on use.
add_zsh_block "zsh-completion" <<'EOF'
fpath=(~/.zfunc(N/) ~/.docker/completions(N/) $fpath)
zmodload zsh/complist
zstyle ':completion:*' menu select
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}' 'r:|[._-]=* r:|=*'
autoload -Uz compinit
() {
  local dump=${ZDOTDIR:-$HOME}/.zcompdump
  local stamp=$dump.fpath
  local -a newer=( $^fpath(N/e:'[[ $REPLY -nt $dump ]]':) )
  if [[ -s $dump && -r $stamp && "$(<$stamp)" == "$fpath" ]] && (( ! $#newer )); then
    compinit -C -d $dump
  else
    rm -f -- $dump
    compinit -d $dump && print -r -- "$fpath" >| $stamp
  fi
}
EOF

# Docker Desktop appends its own fpath+compinit block to .zshrc (and re-adds it
# on updates). Its fpath entry is in zsh-completion above; the extra compinit
# would force a full completion rebuild on every shell start.
remove_docker_desktop_completion() {
  local start="# The following lines have been added by Docker Desktop to enable Docker CLI completions."
  local end="# End of Docker CLI completions"
  grep -qF -- "$start" "$HOME/.zshrc" 2>/dev/null || return 0
  log "🗑  Removing Docker Desktop completion block from $HOME/.zshrc..."
  _sed_i "/^$(_re_escape "$start")\$/,/^$(_re_escape "$end")\$/d" "$HOME/.zshrc"
}
remove_docker_desktop_completion

add_zsh_block "zsh-aliases" <<'EOF'
alias rsync="rsync -ahr --partial --partial-dir=/tmp/.rsync-partial --info=progress2 --no-inc-recursive -e 'ssh -T -o Compression=no' -c"
if command -v bat >/dev/null 2>&1; then
  alias cat='bat --paging=never'
elif command -v batcat >/dev/null 2>&1; then
  alias cat='batcat --paging=never'
fi
EOF

add_block_to_file "$HOME/.zshrc" "direnv" 'if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook zsh)"
fi'

add_zsh_block "fzf" <<'EOF'
if [[ -f /opt/homebrew/opt/fzf/shell/key-bindings.zsh ]]; then
  source /opt/homebrew/opt/fzf/shell/key-bindings.zsh
  source /opt/homebrew/opt/fzf/shell/completion.zsh
elif [[ -f ~/.fzf.zsh ]]; then
  source ~/.fzf.zsh
fi

project-cd-widget() {
  local root dir selected
  local -a candidates

  for root in "$HOME/personal" "$HOME/projects" "$HOME/work"; do
    [[ -d "$root" ]] || continue
    candidates+=("$root")
    for dir in "$root"/* "$root"/*/*; do
      [[ -d "$dir" ]] && candidates+=("$dir")
    done
  done

  (( ${#candidates[@]} )) || return 0
  selected=$(printf '%s\n' "${candidates[@]}" | fzf) || return 0
  [[ -n "$selected" ]] || return 0
  cd -- "$selected"
  zle reset-prompt
}
zle -N project-cd-widget
bindkey '^G' project-cd-widget
EOF

add_zsh_block "go" <<'EOF'
export GOPATH=~/.go
export PATH=$PATH:~/.go/bin
EOF

add_block_to_file "$HOME/.zshrc" "zsh-editing-mode" 'bindkey -e
bindkey -A emacs main
set -o emacs'

# Replaced by project-cd-widget in the fzf block above.
remove_block_from_file "$HOME/.zshrc" "zsh-keybindings"

add_block_to_file "$HOME/.zshrc" "zsh-prompt" "PS1='%n@%m %~ %# '"
add_block_to_file "$HOME/.zshrc" "zsh-options" 'setopt autocd'

add_zsh_block "zsh-plugins" <<'EOF'
source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh 2>/dev/null
source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh 2>/dev/null
EOF

log "Done - restart terminal or run: exec zsh"
