#!/usr/bin/env bash
set -euo pipefail
LOG_PREFIX="[libs]"
source "$(dirname "$0")/_lib"

install() {
  case "$os_name" in
    Darwin) brew install -q "$1" ;;
    Linux)  sudo apt-get install -qq -y "${2:-$1}" ;;
  esac
}

install ripgrep
install fd fd-find
install fzf
install bat

# tree-sitter CLI (needed for nvim-treesitter)
case "$os_name" in
  Darwin) brew install -q tree-sitter ;;
  Linux)  cargo install -q tree-sitter-cli ;;
esac

# On Ubuntu, bat binary is called 'batcat' - create symlink
if [[ "$os_name" == "Linux" ]] && have batcat && ! have bat; then
  mkdir -p ~/.local/bin
  ln -sf "$(command -v batcat)" ~/.local/bin/bat
fi
