#!/usr/bin/env bash
set -euo pipefail
LOG_PREFIX="[docker]"
source "$(dirname "$0")/_lib"

ensure_docker_group() {
  [[ "$os_name" == "Linux" ]] || return 0
  if have getent && ! getent group docker >/dev/null 2>&1; then
    log "docker group not found; skipping group setup"
    return 0
  fi

  if groups "$USER" | grep -qw docker; then
    log "$USER already in docker group"
    return 0
  fi
  log "Adding $USER to docker group"
  sudo usermod -aG docker "$USER"
  log "Logout and login for group changes to take effect (or run: newgrp docker)"
}

# The engine only runs while Docker Desktop is open; start it in the background at login.
ensure_docker_autostart() {
  [[ "$os_name" == "Darwin" ]] || return 0
  local label="com.docker.desktop-autostart"
  local plist_path="${HOME}/Library/LaunchAgents/${label}.plist"
  local uid
  uid="$(id -u)"

  mkdir -p "$(dirname "$plist_path")"
  cat > "$plist_path" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${label}</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/open</string>
    <string>-g</string>
    <string>-a</string>
    <string>Docker</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
PLIST

  if ! launchctl print "gui/${uid}/${label}" >/dev/null 2>&1; then
    log "Starting Docker Desktop at login"
    launchctl bootstrap "gui/${uid}" "$plist_path"
  fi
}

# Stop Docker Desktop from appending its fpath+compinit block to ~/.zshrc: that
# second compinit forces a full completion rebuild on every shell start. Docker
# completions still work: runs/zsh puts ~/.docker/completions on fpath.
# (Install setting osIntegration.configureShellCompletion; the settings store
# is only read at startup and rewritten on quit, so edit it while Docker is down.)
disable_docker_shell_completion() {
  [[ "$os_name" == "Darwin" ]] || return 0
  local store="${HOME}/Library/Group Containers/group.com.docker/settings-store.json"
  [[ -f "$store" ]] || { log "Docker settings store not found yet; start Docker once, quit, re-run"; return 0; }
  if pgrep -xq "com.docker.backend"; then
    log "Docker Desktop is running; quit it and re-run to disable its shell completion setup"
    return 0
  fi
  python3 - "$store" <<'PY'
import json, pathlib, sys
p = pathlib.Path(sys.argv[1])
d = json.loads(p.read_text())
if d.get("ConfigureShellCompletion") is False:
    print("[docker] ✓ shell completion setup already disabled")
    sys.exit(0)
d["ConfigureShellCompletion"] = False
p.write_text(json.dumps(d, indent=2) + "\n")
print("[docker] Disabled Docker Desktop shell completion setup")
PY
}

install_docker() {
  case "$os_name" in
    Darwin)
      log "Installing Docker Desktop (brew cask)"
      brew install --cask docker
      ;;
    Linux)
      log "Installing Docker"
      sudo apt update -qq
      sudo apt install -qq -y ca-certificates curl gnupg

      # Abort rather than trusting a repository key with an unexpected fingerprint.
      local expected_fp="9DC858229FC7DD38854AE2D88D81803C0EBFCD88"
      local tmp_key actual_fp
      tmp_key="$(mktemp)"
      trap 'rm -f "$tmp_key"' EXIT
      curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o "$tmp_key"
      actual_fp="$(gpg --show-keys --with-colons --with-fingerprint "$tmp_key" |
        awk -F: '/^fpr:/ {print $10; exit}')"
      if [[ "$actual_fp" != "$expected_fp" ]]; then
        printf '%s\n' \
          "[docker] Docker GPG fingerprint mismatch!" \
          "[docker]   expected: $expected_fp" \
          "[docker]   got:      ${actual_fp:-<none>}" >&2
        exit 1
      fi
      log "Docker GPG fingerprint verified: $actual_fp"
      sudo install -m 0755 -d /etc/apt/keyrings
      sudo gpg --dearmor -o /etc/apt/keyrings/docker.gpg < "$tmp_key"
      sudo chmod 0644 /etc/apt/keyrings/docker.gpg
      rm -f "$tmp_key"
      trap - EXIT

      echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" |
        sudo tee /etc/apt/sources.list.d/docker.list >/dev/null

      sudo apt update -qq
      sudo apt install -qq -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
      ;;
  esac
}

if have docker; then
  log "Docker already installed"
  docker --version
else
  install_docker
fi
ensure_docker_group
ensure_docker_autostart
disable_docker_shell_completion

if have devpod; then
  log "DevPod already installed"
  devpod version
else
  case "$os_name" in
    Darwin)
      log "Installing DevPod (brew cask)"
      brew install --cask devpod
      ;;
    Linux)
      case "$arch_name" in
        x86_64) arch_suffix="amd64" ;;
        aarch64 | arm64) arch_suffix="arm64" ;;
        *) log "Unsupported architecture: $arch_name"; exit 1 ;;
      esac
      log "Installing DevPod CLI"
      tmp_devpod="$(mktemp)"
      trap 'rm -f "$tmp_devpod"' EXIT
      curl -fsSL -o "$tmp_devpod" "https://github.com/loft-sh/devpod/releases/latest/download/devpod-linux-${arch_suffix}"
      sudo install -c -m 0755 "$tmp_devpod" /usr/local/bin/devpod
      rm -f "$tmp_devpod"
      trap - EXIT
      log "DevPod installed successfully"
      devpod version
      ;;
  esac
fi

log "Installation complete"
