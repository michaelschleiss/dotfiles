#!/usr/bin/env bash
set -euo pipefail
LOG_PREFIX="[macos-keyboard]"
source "$(dirname "$0")/_lib"

if [[ "$os_name" != "Darwin" ]]; then
  log "Skipping: macOS only"
  exit 0
fi

label="com.michael.keyboard"
plist_path="${HOME}/Library/LaunchAgents/${label}.plist"
old_label="com.michael.capslock-delay"
uid="$(id -u)"

mkdir -p "$(dirname "$plist_path")"

log "Setting fast key repeat"
defaults write -g KeyRepeat -int 1
defaults write -g InitialKeyRepeat -int 10

# Caps Lock -> Left Control via hidutil (HID usages 0x700000039 -> 0x7000000E0),
# plus no Caps Lock activation delay. The native per-keyboard modifiermapping
# preference no longer takes effect on macOS 27, and a one-shot UserKeyMapping
# lapses after deep-sleep wake, so the agent re-applies it every minute
# (launchd also fires a missed interval right after wake).
hid_props='{"CapsLockDelayOverride":0,"UserKeyMapping":[{"HIDKeyboardModifierMappingSrc":0x700000039,"HIDKeyboardModifierMappingDst":0x7000000E0}]}'

if launchctl print "gui/${uid}/${old_label}" >/dev/null 2>&1; then
  log "Removing superseded ${old_label} LaunchAgent"
  launchctl bootout "gui/${uid}/${old_label}" >/dev/null 2>&1 || true
fi
rm -f "${HOME}/Library/LaunchAgents/${old_label}.plist"

log "Installing ${label} LaunchAgent"
cat > "${plist_path}" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${label}</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/hidutil</string>
    <string>property</string>
    <string>--set</string>
    <string>${hid_props}</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>/dev/null</string>
</dict>
</plist>
PLIST

if launchctl print "gui/${uid}/${label}" >/dev/null 2>&1; then
  log "Reloading ${label}"
  launchctl bootout "gui/${uid}" "${plist_path}" >/dev/null 2>&1 || true
fi

launchctl bootstrap "gui/${uid}" "${plist_path}"
launchctl kickstart -k "gui/${uid}/${label}"

log "Done"
