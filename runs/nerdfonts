#!/usr/bin/env bash
set -euo pipefail
LOG_PREFIX="[fonts]"
source "$(dirname "$0")/_lib"

FONT_NAME="JetBrainsMono"

if [[ "$os_name" == "Darwin" ]]; then
  log "Installing $FONT_NAME Nerd Font (brew)"
  brew install --cask font-jetbrains-mono-nerd-font

elif [[ "$os_name" == "Linux" ]]; then
  if fc-list | grep -qi "$FONT_NAME"; then
    log "$FONT_NAME Nerd Font already installed"
    exit 0
  fi

  log "Installing $FONT_NAME Nerd Font"
  tmpdir="$(mktemp -d)"
  curl -fsSL "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/$FONT_NAME.zip" \
    -o "$tmpdir/font.zip"

  mkdir -p "$HOME/.local/share/fonts"
  unzip -q "$tmpdir/font.zip" -d "$HOME/.local/share/fonts/$FONT_NAME"

  rm -rf "$tmpdir"

  log "Refreshing font cache"
  fc-cache -fv >/dev/null

  log "Done - set 'JetBrainsMono Nerd Font' in your terminal"
fi
