#!/usr/bin/env bash
set -euo pipefail
LOG_PREFIX="[base]"
source "$(dirname "$0")/_lib"

# --- Homebrew (macOS) ---
if [[ "$os_name" == "Darwin" ]] && ! have brew; then
  log "Installing Homebrew"
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" >/dev/null
fi

# --- Essential tools ---
log "Installing essential packages"
if [[ "$os_name" == "Darwin" ]]; then
  brew install -q git curl wget aria2 pkg-config dua-cli node
  brew install -q --cask nikitabobko/tap/aerospace
  brew install -q --cask xquartz
elif [[ "$os_name" == "Linux" ]]; then
  sudo apt-get update -qq
  sudo apt-get install -qq -y \
    git \
    curl \
    wget \
    aria2 \
    build-essential \
    pkg-config \
    unzip \
    htop \
    ninja-build \
    cmake \
    openssh-server \
    avahi-utils `# mDNS/Bonjour CLI tools (avahi-browse, avahi-resolve)` \
    python3-pip \
    python3-venv
  sudo systemctl enable --now ssh -q
  # Install Node.js 24 LTS via NodeSource (apt version is too old)
  if ! command -v node &>/dev/null || (( $(node -v | cut -d. -f1 | tr -d v) < 24 )); then
    log "Installing Node.js 24 LTS via NodeSource"
    curl -fsSL https://deb.nodesource.com/setup_24.x | sudo -E bash -
    sudo apt-get install -qq -y nodejs
  fi
  # Install Rust via rustup (apt version is too old)
  if ! command -v rustup &>/dev/null; then
    log "Installing Rust via rustup"
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y -q
  fi
  # Install dua-cli via cargo (not in apt)
  if ! command -v dua &>/dev/null; then
    log "Installing dua-cli"
    "$HOME/.cargo/bin/cargo" install dua-cli -q
  fi
fi

# --- direnv (per-directory env vars) ---
if ! have direnv; then
  log "Installing direnv"
  if [[ "$os_name" == "Darwin" ]]; then
    brew install direnv
  elif [[ "$os_name" == "Linux" ]]; then
    sudo apt-get install -qq -y direnv
  fi
fi

# --- Pixi (fast package manager for Python/ML) ---
# PATH comes from runs/zsh-profile; keep the installer out of shell rc files.
if ! have pixi && [[ ! -x "$HOME/.pixi/bin/pixi" ]]; then
  log "Installing Pixi"
  curl -fsSL https://pixi.sh/install.sh | PIXI_NO_PATH_UPDATE=1 bash -s -- --quiet >/dev/null 2>&1
fi
# Drop the PATH line earlier Pixi installs appended.
pixi_path_line="export PATH=\"$HOME/.pixi/bin:\$PATH\""
for rc in "$HOME/.zshrc" "$HOME/.bashrc"; do
  if grep -qxF -- "$pixi_path_line" "$rc" 2>/dev/null; then
    log "Removing Pixi PATH line from $rc"
    _sed_i "/^$(_re_escape "$pixi_path_line")\$/d" "$rc"
  fi
done

# --- Mutagen (real-time file sync for remote dev) ---
mutagen_version="0.18.1"
if [[ "$os_name" == "Darwin" ]] && ! have mutagen; then
  log "Installing Mutagen"
  brew install -q mutagen-io/mutagen/mutagen
elif [[ "$os_name" == "Linux" ]] && [[ "$(mutagen version 2>/dev/null)" != "$mutagen_version" ]]; then
  case "$arch_name" in
    x86_64) mutagen_arch="amd64" ;;
    aarch64 | arm64) mutagen_arch="arm64" ;;
    *) echo "Unsupported architecture for Mutagen: $arch_name" >&2; exit 1 ;;
  esac
  log "Installing Mutagen $mutagen_version"
  mutagen_tmp="$(mktemp -d)"
  curl -fsSL "https://github.com/mutagen-io/mutagen/releases/download/v${mutagen_version}/mutagen_linux_${mutagen_arch}_v${mutagen_version}.tar.gz" \
    | tar -xz -C "$mutagen_tmp"
  # The agent bundle must sit next to the binary for remote syncs.
  sudo install -m 0755 "$mutagen_tmp/mutagen" /usr/local/bin/mutagen
  sudo install -m 0644 "$mutagen_tmp/mutagen-agents.tar.gz" /usr/local/bin/mutagen-agents.tar.gz
  rm -rf "$mutagen_tmp"
fi

# --- Ghostty terminal ---
if ! have ghostty; then
  if [[ "$os_name" == "Darwin" ]]; then
    log "Installing Ghostty (brew cask)"
    brew install -q --cask ghostty
  elif [[ "$os_name" == "Linux" ]]; then
    log "Installing Ghostty (.deb from ghostty-ubuntu)"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/mkasberg/ghostty-ubuntu/HEAD/install.sh)"
  fi
fi

# --- Brave browser (Linux only, macOS has Safari) ---
if [[ "$os_name" == "Linux" ]] && ! have brave-browser; then
  log "Installing Brave (apt)"
  sudo curl -fsSLo /usr/share/keyrings/brave-browser-archive-keyring.gpg \
    https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg
  echo "deb [signed-by=/usr/share/keyrings/brave-browser-archive-keyring.gpg] https://brave-browser-apt-release.s3.brave.com/ stable main" \
    | sudo tee /etc/apt/sources.list.d/brave-browser-release.list >/dev/null
  sudo apt-get update -qq
  sudo apt-get install -qq -y brave-browser
fi

log "Done"
